# Copy to .env at the repo root if you use root-level tooling.
# App-specific env: copy each app's .env.example → .env (see README).

# --- packages/api (primary) ---
# cd packages/api && cp .env.example .env
DATABASE_URL="postgresql://arara:arara@localhost:5434/arara_platform?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30
APP_SECRETS_KEY="replace-with-openssl-rand-base64-32"
PORT=4100
HOST=0.0.0.0
PUBLIC_HOST=localhost

# Dev seed passwords (packages/api/prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@arara.local
SEED_ADMIN_PASSWORD=change-me-admin
SEED_DEV_EMAIL=fernandinho@arara.local
SEED_DEV_PASSWORD=change-me-dev

# Deploy (scripts / GitHub Actions variables — do not commit real values)
# DEPLOY_HOST=your.server.ip
# DEPLOY_USER=debian
# REMOTE_HOST=your-ssh-host-alias
