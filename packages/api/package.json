{
  "name": "@arara/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "integrate:portal-suporte": "tsx scripts/portal-suporte/integrate.ts",
    "integrate:portal-cursos": "tsx scripts/portal-cursos/integrate.ts",
    "enrich:portal-suporte-controllers": "tsx scripts/portal-suporte/enrich-controllers.ts",
    "enrich:portal-suporte-whatsapp": "tsx scripts/portal-suporte/enrich-whatsapp-controllers.ts",
    "enrich:portal-crm-schemas": "tsx scripts/portal-crm/enrich-schemas-and-seed.ts",
    "enrich:portal-crm-controllers": "tsx scripts/portal-crm/enrich-controllers.ts",
    "generate:portal-suporte-manifest": "python3 scripts/portal-suporte/generate-manifest.py",
    "unify:users": "tsx scripts/unify-users.ts",
    "remap:user-fks": "tsx scripts/remap-user-fks.ts",
    "integrate:app": "tsx scripts/integrate-app.ts",
    "dump:hostinger": "bash scripts/dump-hostinger-prod.sh",
    "integrate:all-apps": "tsx scripts/unify-users.ts && tsx scripts/integrate-app.ts --slug portal-crm --name \"Portal CRM\" --prod data/portal-crm-prod && tsx scripts/integrate-app.ts --slug time-management --name \"Portal Horas\" --prod data/time-management-prod && tsx scripts/integrate-app.ts --slug portal-araratech --name \"Portal AraraTech\" --prod data/portal-araratech-prod --schema-only && tsx scripts/remap-user-fks.ts",
    "export:routes": "tsx ../../tooling/export-routes-from-db.ts",
    "codegen:routes": "tsx ../../tooling/codegen-static-routes.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/http-proxy": "^11.6.0",
    "@fastify/multipart": "^10.1.0",
    "@prisma/client": "^6.9.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.0.11",
    "path-to-regexp": "^8.2.0",
    "undici": "^8.8.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
