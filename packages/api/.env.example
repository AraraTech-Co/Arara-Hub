DATABASE_URL="postgresql://arara:arara@localhost:5434/arara_platform?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret"
# Access JWT TTL (jose format: 7d, 24h, …)
JWT_EXPIRES_IN=7d
# Opaque refresh token lifetime (days); rotated on each /v1/auth/refresh
REFRESH_TOKEN_EXPIRES_DAYS=30
# AES-256 master key for AppSecret (base64 of 32 random bytes). Do not reuse JWT_SECRET.
# Generate: openssl rand -base64 32
APP_SECRETS_KEY="replace-with-openssl-rand-base64-32"
PORT=4100
HOST=0.0.0.0
PUBLIC_HOST=localhost
SANDBOX_TIMEOUT_MS=15000
SANDBOX_MEMORY_MB=32
# Global hosts for ctx.fetch (empty = only BY_APP). Prefer BY_APP so other portals stay closed.
SANDBOX_FETCH_ALLOWLIST=
# Per-app hosts: slug:hostname (comma-separated). Empty global + empty BY_APP for that app = deny all.
SANDBOX_FETCH_ALLOWLIST_BY_APP=portal-suporte:www.avisaapi.com.br,portal-suporte:openrouter.ai,portal-suporte:api.arara-tech.com,portal-horas:api.arara-tech.com
SANDBOX_FETCH_TIMEOUT_MS=8000

# Dev seed users (prisma/seed.ts) — never use these passwords in production
SEED_ADMIN_EMAIL=admin@arara.local
SEED_ADMIN_PASSWORD=change-me-admin
SEED_DEV_EMAIL=fernandinho@arara.local
SEED_DEV_PASSWORD=change-me-dev
