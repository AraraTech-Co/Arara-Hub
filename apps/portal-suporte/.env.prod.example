# =============================================================================
# PRODUÇÃO — portal-suporte Arara Tech
# Copie este arquivo para .env.prod e preencha os valores
# cp .env.prod.example .env.prod
# =============================================================================

# =============================================================================
# Banco de Dados (PostgreSQL)
# =============================================================================
DB_USER=portaluser
DB_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI
DB_NAME=portalsupport

# =============================================================================
# Autenticação (Auth.js / NextAuth)
# =============================================================================
# Gere com: openssl rand -hex 32
AUTH_SECRET=TROQUE_POR_SECRET_ALEATORIO_AQUI

# URL pública do portal (sem barra no final)
AUTH_URL=http://YOUR_DEPLOY_HOST
NEXT_PUBLIC_SITE_URL=http://YOUR_DEPLOY_HOST

# CSRF / Origin enforcement
# Lista CSV de origens aceitas além de NEXT_PUBLIC_SITE_URL.
# Útil quando o portal é acessado por mais de um host (ex.: domínio + IP, ou
# múltiplos subdomínios). A própria origem da request (Host header) também
# é aceita automaticamente — então em proxy reverso simples nem precisa setar.
# Exemplo:
# ALLOWED_ORIGINS=http://suporte.arara-tech.com:3000,https://suporte.arara-tech.com
ALLOWED_ORIGINS=

# =============================================================================
# Meilisearch
# =============================================================================
# Gere com: openssl rand -hex 24
MEILISEARCH_API_KEY=TROQUE_POR_CHAVE_MEILISEARCH_AQUI

# =============================================================================
# Redis (sem senha por padrão — adicione se expor externamente)
# =============================================================================
REDIS_PASSWORD=

# =============================================================================
# OpenAI / Recursos de IA (opcional)
# =============================================================================
# Para LIGAR a IA (triagem automática, chat com IA, análise de ticket):
#   1. AI_FEATURES_ENABLED=true
#   2. OPENAI_API_KEY=sk-... (chave válida da OpenAI)
#
# Com AI_FEATURES_ENABLED=false (ou chave inválida/placeholder), todos os
# pontos de IA ficam desligados silenciosamente. Endpoints /api/ai/* respondem
# 503 com mensagem clara. Sem 401 poluindo os logs.
AI_FEATURES_ENABLED=false
OPENAI_API_KEY=sk-sua-chave-openai-aqui
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# Cron Jobs
# =============================================================================
# Gere com: openssl rand -hex 32
CRON_SECRET=TROQUE_POR_SECRET_CRON_AQUI

# =============================================================================
# Cadastro de funcionários (agentes/admins)
# =============================================================================
# Gere com: openssl rand -hex 16
# Deixe em branco para desabilitar cadastro público de funcionários
EMPLOYEE_INVITE_CODE=TROQUE_POR_CODIGO_CONVITE_AQUI

# =============================================================================
# Integrações opcionais
# =============================================================================
DISCORD_WEBHOOK_URL=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_BUSINESS_PHONE_ID=
TRELLO_API_KEY=
TRELLO_TOKEN=

# =============================================================================
# Tuning de segurança (defaults sensatos — descomente para sobrescrever)
# =============================================================================
# Custo do bcrypt em rounds (default 12). Maior = mais lento + mais seguro.
# BCRYPT_ROUNDS=12

# Rate limits por IP (max/janela em segundos)
# FORGOT_PASSWORD_RATE_MAX=3
# FORGOT_PASSWORD_RATE_WINDOW=3600
# RESET_PASSWORD_RATE_MAX=5
# RESET_PASSWORD_RATE_WINDOW=3600
# REGISTER_RATE_MAX=3
# REGISTER_RATE_WINDOW=3600
# PUBLIC_REPLY_RATE_MAX=5
# PUBLIC_REPLY_RATE_WINDOW=60
# PUBLIC_REPLY_MAX_LENGTH=5000

# TTL do reset token em ms (default 30 min = 1800000)
# RESET_TOKEN_TTL_MS=1800000

# BotConversa — provedor de WhatsApp
BOTCONVERSA_API_KEY=
BOTCONVERSA_API_URL=https://backend.botconversa.com.br/api/v1/webhook
BOTCONVERSA_WEBHOOK_SECRET=
BOTCONVERSA_STATUS_PAUSE=
BOTCONVERSA_STATUS_RESUME=

# RustDesk self-hosted (acesso remoto) — não versionar valores reais
NEXT_PUBLIC_RUSTDESK_HOST=YOUR_DEPLOY_HOST
NEXT_PUBLIC_RUSTDESK_KEY=YOUR_RUSTDESK_PUBLIC_KEY
