# Vite SPA → nginx
ARG APP_DIR=apps/portal-horas
ARG VITE_ARARA_APP_SLUG=portal-horas
ARG VITE_ARARA_API_URL=https://api.arara-tech.com

FROM node:22-bookworm-slim AS builder
WORKDIR /src
ARG APP_DIR
ARG VITE_ARARA_APP_SLUG
ARG VITE_ARARA_API_URL
ENV VITE_ARARA_API_URL=${VITE_ARARA_API_URL}
ENV VITE_ARARA_APP_SLUG=${VITE_ARARA_APP_SLUG}
COPY ${APP_DIR}/package.json ${APP_DIR}/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY ${APP_DIR}/ ./
RUN npm run build

FROM nginx:1.27-alpine
ARG VITE_ARARA_APP_SLUG
RUN apk add --no-cache gettext
COPY deploy/nginx/spa.conf.template /etc/nginx/templates/spa.conf.template
COPY deploy/nginx/security-headers.conf /etc/nginx/templates/security-headers.conf
# O entrypoint escolhe a política de conteúdo por este slug; todas vão na imagem
# porque é uma só que serve cada front, e escolher em tempo de execução deixa a
# imagem igual à que foi provada.
ENV ARARA_APP_SLUG=${VITE_ARARA_APP_SLUG}
COPY deploy/nginx/csp-*.conf /etc/nginx/templates/
COPY deploy/nginx/docker-entrypoint.sh /docker-entrypoint-spa.sh
RUN chmod +x /docker-entrypoint-spa.sh
COPY --from=builder /src/dist /usr/share/nginx/html
ENV API_UPSTREAM=http://arara-platform-prd:4100
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint-spa.sh"]
